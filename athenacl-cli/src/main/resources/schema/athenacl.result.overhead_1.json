{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenacl.result.overhead/1",
  "type": "object",
  "required": ["schema", "ok", "command", "data", "warnings", "errors", "meta"],
  "properties": {
    "schema": { "const": "athenacl.result.overhead/1" },
    "ok": { "type": "boolean" },
    "command": { "const": "debug overhead" },
    "data": {
      "type": "object",
      "required": ["identical", "ratio", "notes"],
      "properties": {
        "identical": { "type": "boolean" },
        "offMs": { "type": "number" },
        "provenanceMs": { "type": "number" },
        "ratio": { "type": "number" },
        "notes": { "type": "integer" }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["version", "seed", "durationMs"]
    }
  }
}
