# Deploying Pitch Sieves with HarmonicAssembly
tpsd 7
tmsd 7
emo m
pin a 11@1|13@2|23@5|25@6,c1,c7
tmo ha
tin a 0
tie t 0,30
tie a rb,.2,.2,.6,1
tie b c,120
tie r pt,(c,4),(mv,a{1}b{3}:{a=12|b=1}),(mv,a{1}b{0}:{a=9|b=1}),(c,.8)
tie d0 c,0
tie d1 ru,(bpl,t,l,[(0,0),(30,12)]),(bpl,t,l,[(0,3),(30,15)])
tie d2 c,1
tie d3 bg,rc,(2,3)
eln
