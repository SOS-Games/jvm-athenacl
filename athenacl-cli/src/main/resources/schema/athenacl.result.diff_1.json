{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenacl.result.diff/1",
  "type": "object",
  "required": ["schema", "ok", "command", "data", "warnings", "errors", "meta"],
  "properties": {
    "schema": { "const": "athenacl.result.diff/1" },
    "ok": { "type": "boolean" },
    "command": { "const": "diff" },
    "data": {
      "type": "object",
      "required": ["identical"],
      "properties": {
        "identical": { "type": "boolean" },
        "changes": { "type": "array" },
        "firstDivergentBar": { "type": "integer" }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["version", "seed", "durationMs"]
    }
  }
}
