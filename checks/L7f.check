# L7f ensemble selection from descriptors. Directive list: AGENTS.md, section "Layer checks".

name: fantasy sneaking fills every role
args: ensemble select --genre fantasy --state sneaking --seed 1 --explain
exit: 0
stdout-contains: role=lead
stdout-contains: role=pad
stdout-contains: role=bass
stdout-contains: role=arp
stdout-contains: seed=1/ensemble/lead
stdout-not-contains: pairs.maxRoughness
stdout-not-contains: ensemble.fallback

---
name: the same seed matches
args: ensemble select --genre fantasy --state sneaking --seed 1
exit: 0
stdout-same-as: ensemble select --genre fantasy --state sneaking --seed 1

---
name: another seed still selects
args: ensemble select --genre fantasy --state sneaking --seed 2
exit: 0
stdout-contains: role=lead
stdout-not-contains: ensemble.fallback

---
name: a pin names the lead
args: ensemble select samples/themes/pin.yaml --state combat --seed 1
exit: 0
stdout-contains: role=lead instrument=saw
stdout-contains: from=pin

---
name: a missing kit keeps the fixed instruments
args: ensemble select --genre fantasy --state sneaking --kit nosuchprofile
exit: 0
stdout-contains: ensemble.fallback=fixed

---
name: resolve names the automatic source
args: theme resolve --genre fantasy --state sneaking --seed 1 --explain
exit: 0
stdout-contains: source=ensemble:auto
