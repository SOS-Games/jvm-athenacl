{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenacl.result.determinism/1",
  "type": "object",
  "required": ["schema", "ok", "command", "data", "warnings", "errors", "meta"],
  "properties": {
    "schema": { "const": "athenacl.result.determinism/1" },
    "ok": { "type": "boolean" },
    "command": { "const": "debug determinism" },
    "data": {
      "type": "object",
      "required": ["runs", "identical", "hash"],
      "properties": {
        "runs": { "type": "integer" },
        "identical": { "type": "boolean" },
        "hash": { "type": "string" }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["version", "seed", "durationMs"]
    }
  }
}
