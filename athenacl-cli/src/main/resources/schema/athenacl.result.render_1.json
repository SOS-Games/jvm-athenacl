{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenacl.result.render/1",
  "type": "object",
  "required": ["schema", "ok", "command", "data", "warnings", "errors", "meta"],
  "properties": {
    "schema": { "const": "athenacl.result.render/1" },
    "ok": { "type": "boolean" },
    "command": { "const": "render" },
    "data": {
      "type": "object",
      "required": ["files", "notes", "bars", "changed", "hash"],
      "properties": {
        "files": { "type": "integer" },
        "notes": { "type": "integer" },
        "bars": { "type": "integer" },
        "changed": { "type": "boolean" },
        "hash": { "type": "string" },
        "dryRun": { "type": "boolean" },
        "seed": { "type": "string" }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["version", "seed", "durationMs"]
    }
  }
}
