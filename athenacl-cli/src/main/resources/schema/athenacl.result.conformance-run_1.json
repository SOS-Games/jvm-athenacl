{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenacl.result.conformance-run/1",
  "type": "object",
  "required": ["schema", "ok", "command", "data", "warnings", "errors", "meta"],
  "properties": {
    "schema": { "const": "athenacl.result.conformance-run/1" },
    "ok": { "type": "boolean" },
    "command": { "const": "conformance run" },
    "data": {
      "type": "object",
      "required": ["scripts", "missing", "fail"],
      "properties": {
        "scripts": { "type": "integer" },
        "missing": { "type": "integer" },
        "fail": { "type": "integer" }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["version", "seed", "durationMs"]
    }
  }
}
