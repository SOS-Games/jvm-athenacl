{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athenacl.result.bisect/1",
  "type": "object",
  "required": ["schema", "ok", "command", "data", "warnings", "errors", "meta"],
  "properties": {
    "schema": { "const": "athenacl.result.bisect/1" },
    "ok": { "type": "boolean" },
    "command": { "const": "debug bisect" },
    "data": {
      "type": "object",
      "required": ["firstDivergentBar", "identical"],
      "properties": {
        "firstDivergentBar": { "type": "integer" },
        "event": { "type": "integer" },
        "added": { "type": "integer" },
        "removed": { "type": "integer" },
        "changed": { "type": "integer" },
        "firstControl": { "type": "integer" },
        "identical": { "type": "boolean" }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["version", "seed", "durationMs"]
    }
  }
}
