# L9 sci-fi space. Directive list: AGENTS.md, section "Layer checks".

name: sci-fi theme is valid
args: theme validate themes/scifi-space.yaml
exit: 0
stdout-contains: states=6
stdout-contains: warnings=0

---
name: show the sci-fi preset
args: preset show scifi-space
exit: 0
stdout-contains: preset=scifi-space
stdout-contains: celesta

---
name: render the space tour
args: render themes/scifi-space.yaml --timeline samples/timelines/dungeon-tour.json --seed 1 --out build/l9 --formats mid,wav,events,txt
exit: 0
delete-before: build/l9
stdout-contains: bars=14
stdout-contains: kit=gm-lite
stdout-contains: states=sneaking,peaceful,danger,combat,trading,partying
file-exists: build/l9/score.wav
file-exists: build/l9/events.jsonl

---
name: loudness follows the contour
args: analyze build/l9 --by state
exit: 0
stdout-regex: loudness\.sneaking=(-2\.[0-5]|-1\.[0-9]|-0\.[5-9])
stdout-regex: loudness\.peaceful=(-2\.0|-1\.[0-9]|-0\.[0-9]|\+0\.0)
stdout-regex: loudness\.trading=(-2\.0|-1\.[0-9]|-0\.[0-9]|\+0\.0)
stdout-regex: loudness\.partying=(\+0\.[5-9]|\+1\.[0-9]|\+2\.[0-5])
stdout-regex: loudness\.danger=(\+1\.[0-9]|\+2\.[0-9]|\+3\.0)
stdout-regex: loudness\.combat=(\+3\.[0-9]|\+4\.[0-9]|\+5\.0)
stdout-regex: loudness\.spread=([0-5]\.[0-9]|6\.0)

---
name: opening bars are synth arpeggios
args: describe-music build/l9/events.jsonl --bars 1-4
exit: 0
stdout-contains: arp
stdout-contains: arp.grid=8th
stdout-contains: programs=38,80,95
stdout-not-contains: harp
stdout-not-contains: taiko
stdout-not-contains: flute

---
name: fantasy switches to sci-fi on the next bar
args: render themes/fantasy-dungeon.yaml --at "8 theme themes/scifi-space.yaml" --bars 1-16 --seed 1
exit: 0
stdout-contains: themeSwitch.bar=9
