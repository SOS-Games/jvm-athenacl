# L13 path slice. Directive list: AGENTS.md, section "Layer checks".

name: c major path matches the golden
args: athena run conformance/paths/c-major.ath --out build/l13
exit: 0
stdout-contains: bytesEqualGolden=true
stdout-contains: notes=6
stdout-contains: tracks=1
file-exists: build/l13/c-major.mid
delete-before: build/l13

---
name: two tracks match the golden
args: athena run conformance/paths/triads.ath --out build/l13b
exit: 0
stdout-contains: bytesEqualGolden=true
stdout-contains: notes=7
stdout-contains: tracks=2
file-exists: build/l13b/triads.mid

---
name: an amplitude script is not this slice
args: athena run conformance/demos/script01a.ath --out build/l13c
exit: 3
stdout-contains: error code=ATHENA_TEXTURE
file-absent: build/l13c
